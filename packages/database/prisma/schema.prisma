model Shipment {
  id                        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId                   String         @map("store_id") @db.Uuid
  orderId                   String         @map("order_id") @db.Uuid
  warehouseId               String         @map("warehouse_id") @db.Uuid
  channelId                 String         @map("channel_id") @db.Uuid
  publicShipmentNumber      String         @unique @map("public_shipment_number") @db.VarChar(64)
  status                    ShipmentStatus @default(CREATION_PENDING)
  version                   Int            @default(1)
  clientOrderCode           String         @map("client_order_code") @db.VarChar(64)
  providerShipmentId        String?        @map("provider_shipment_id") @db.VarChar(160)
  serviceCode               String         @map("service_code") @db.VarChar(64)
  providerServiceId         Int?           @map("provider_service_id")
  providerServiceTypeId     Int?           @map("provider_service_type_id")
  codAmountVnd              BigInt         @default(0) @map("cod_amount_vnd")
  addressSnapshotCiphertext String         @map("address_snapshot_ciphertext") @db.Text
  parcelSnapshot            Json           @map("parcel_snapshot")
  labelMetadata             Json?          @map("label_metadata")
  createdOperationId        String?        @unique @map("created_operation_id") @db.Uuid
  cancelledOperationId      String?        @unique @map("cancelled_operation_id") @db.Uuid
  providerCreatedAt         DateTime?      @map("provider_created_at") @db.Timestamptz(6)
  pickedUpAt                DateTime?      @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt               DateTime?      @map("delivered_at") @db.Timestamptz(6)
  returnedAt                DateTime?      @map("returned_at") @db.Timestamptz(6)
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  store      Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order      Order                @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Restrict)
  warehouse  Warehouse            @relation(fields: [storeId, warehouseId], references: [storeId, id], onDelete: Restrict)
  channel    StoreShippingChannel @relation(fields: [storeId, channelId], references: [storeId, id], onDelete: Restrict)
  items      ShipmentItem[]
  events     TrackingEvent[]
  operations ShippingOperation[]

  @@unique([storeId, id])
  @@unique([storeId, id, orderId])
  @@unique([storeId, channelId, clientOrderCode])
  @@unique([storeId, channelId, providerShipmentId])
  @@index([storeId, orderId, createdAt(sort: Desc)])
  @@index([storeId, status, updatedAt])
  @@map("shipments")
}

model ShipmentItem {
