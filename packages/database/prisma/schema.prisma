  @@unique([storeId, id])
  @@unique([storeId, shipmentId, providerEventKey])
  @@index([storeId, shipmentId, occurredAt, id])
  @@map("tracking_events")
}

model ShippingOperation {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId            String                     @map("store_id") @db.Uuid
  orderId            String                     @map("order_id") @db.Uuid
  shipmentId         String?                    @map("shipment_id") @db.Uuid
  channelId          String                     @map("channel_id") @db.Uuid
  operationType      ShippingOperationType      @map("operation_type")
  idempotencyKeyHash String                     @map("idempotency_key_hash") @db.Char(64)
  requestHash        String                     @map("request_hash") @db.Char(64)
  status             IntegrationOperationStatus @default(PENDING)
  attemptCount       Int                        @default(0) @map("attempt_count")
  nextAttemptAt      DateTime?                  @map("next_attempt_at") @db.Timestamptz(6)
  errorCode          String?                    @map("error_code") @db.VarChar(64)
  correlationId      String                     @map("correlation_id") @db.VarChar(128)
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  store    Store                @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order    Order                @relation(fields: [storeId, orderId], references: [storeId, id], onDelete: Restrict)
  shipment Shipment?            @relation(fields: [storeId, shipmentId, orderId], references: [storeId, id, orderId], onDelete: Restrict)
  channel  StoreShippingChannel @relation(fields: [storeId, channelId], references: [storeId, id], onDelete: Restrict)

  @@unique([storeId, id])
  @@unique([storeId, channelId, operationType, idempotencyKeyHash])
  @@index([storeId, orderId, createdAt(sort: Desc)])
  @@index([storeId, status, nextAttemptAt, id])
  @@map("shipping_operations")
}

model OutboxMessage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  aggregateType  String       @map("aggregate_type") @db.VarChar(64)
  aggregateId    String       @map("aggregate_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(128)
  eventVersion   Int          @map("event_version")
  idempotencyKey String       @map("idempotency_key") @db.VarChar(160)
  payload        Json
  status         OutboxStatus @default(PENDING)
  availableAt    DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner     String?      @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime?    @map("lease_expires_at") @db.Timestamptz(6)
  attemptCount   Int          @default(0) @map("attempt_count")
  maxAttempts    Int          @default(8) @map("max_attempts")
  lastErrorCode  String?      @map("last_error_code") @db.VarChar(64)
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz(6)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, id])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, status, availableAt, id])
  @@index([storeId, leaseExpiresAt])
  @@map("outbox_messages")
}

model InboxMessage {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId             String                 @map("store_id") @db.Uuid
  source              String                 @db.VarChar(64)
  channelId           String                 @map("channel_id") @db.Uuid
  environment         IntegrationEnvironment
  externalMessageKey  String                 @map("external_message_key") @db.VarChar(160)
  payloadDigest       String                 @map("payload_digest") @db.Char(64)
  status              InboxStatus            @default(RECEIVED)
  receivedAt          DateTime               @default(now()) @map("received_at") @db.Timestamptz(6)
  processingStartedAt DateTime?              @map("processing_started_at") @db.Timestamptz(6)
  completedAt         DateTime?              @map("completed_at") @db.Timestamptz(6)
  errorCode           String?                @map("error_code") @db.VarChar(64)
  version             Int                    @default(1)

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  @@unique([storeId, id])
  @@unique([source, channelId, environment, externalMessageKey])
  @@index([storeId, status, receivedAt, id])
  @@map("inbox_messages")
}

