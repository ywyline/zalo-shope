model TrackingEvent {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId              String              @map("store_id") @db.Uuid
  shipmentId           String              @map("shipment_id") @db.Uuid
  providerEventKey     String              @map("provider_event_key") @db.VarChar(160)
  status               ShipmentStatus
  providerStatus       String              @map("provider_status") @db.VarChar(64)
  reasonCode           String?             @map("reason_code") @db.VarChar(64)
